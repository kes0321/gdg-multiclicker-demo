# Compose reads this file after copying it to .env. No secrets are required locally.
COMPOSE_PROJECT_NAME=multiclicker
HTTP_PORT=80
# Defaults below also support the optional HTTPS override; see docs/HTTPS.md.
HTTPS_PORT=443
ACME_WEBROOT=./.acme-webroot
LETSENCRYPT_DIR=/etc/letsencrypt
# On the Linux VM only, enable AFTER issuing the certificate:
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# false for local HTTP; the HTTPS override enforces true.
SESSION_COOKIE_SECURE=false
# Backend defaults when run directly on Windows. Compose overrides these.
REDIS_HOST=localhost
REDIS_PORT=6379
# Vite's optional development proxy target (set in frontend/.env.local).
# BACKEND_URL=http://localhost:8000
# Optional superadmin. Leave both empty to disable. See docs/ADMIN.md.
# Generate values with: python -B -m app.admin.security (inside backend/).
ADMIN_PATH=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=1800
