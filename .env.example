# Compose reads this file after copying it to .env. No secrets are required locally.
COMPOSE_PROJECT_NAME=multiclicker
HTTP_PORT=80
# false for local HTTP; true only after configuring HTTPS termination.
SESSION_COOKIE_SECURE=false
# Backend defaults when run directly on Windows. Compose overrides these.
REDIS_HOST=localhost
REDIS_PORT=6379
# Vite's optional development proxy target (set in frontend/.env.local).
# BACKEND_URL=http://localhost:8000
